{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import os,http.server,socketserver; port=int(os.environ['PORT']); socketserver.TCPServer(('', port), http.server.SimpleHTTPRequestHandler).serve_forever()"],
